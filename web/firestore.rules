rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NGUYÊN TẮC BẢO MẬT: MẶC ĐỊNH TỪ CHỐI TẤT CẢ (DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // KHỐI 1: BẢNG HỒ SƠ NGƯỜI DÙNG (/users/{userId})
    // - Chỉ chủ tài khoản mới được quyền đọc và ghi dữ liệu của chính mình.
    // - Kiểm tra tính hợp lệ: displayName phải là chuỗi từ 1 đến 50 ký tự.
    // - uid (nếu có trong body) phải trùng khớp với request.auth.uid.
    // =========================================================================
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && (!('email' in request.resource.data) || request.resource.data.email is string);

      // =======================================================================
      // KHỐI 2: DANH SÁCH GIAO DỊCH THU / CHI (/users/{userId}/transactions/{txId})
      // - Chỉ chủ tài khoản mới được đọc, tạo, sửa, xóa giao dịch của mình.
      // - type: bắt buộc là 'income' hoặc 'expense'.
      // - amount: bắt buộc là số dương (> 0).
      // - date: bắt buộc là chuỗi ngày tháng (YYYY-MM-DD).
      // - note: nếu có phải là chuỗi không quá 500 ký tự.
      // =======================================================================
      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is string
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      }

      // =======================================================================
      // KHỐI 3: THIẾT LẬP NGÂN SÁCH THÁNG (/users/{userId}/budgets/{monthYear})
      // - Chỉ chủ tài khoản mới được đọc, lưu và xóa ngân sách tháng của mình.
      // - totalLimit: bắt buộc là số không âm (>= 0).
      // =======================================================================
      match /budgets/{monthYear} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.totalLimit is number
          && request.resource.data.totalLimit >= 0;
      }

      // =======================================================================
      // KHỐI 4: LỊCH SỬ CHAT VÀ TIN NHẮN AI (/users/{userId}/aiConversations/{convId})
      // - Chỉ chủ tài khoản mới được đọc, tạo, sửa, xóa cuộc trò chuyện của mình.
      // - userId: bắt buộc trùng với request.auth.uid.
      // =======================================================================
      match /aiConversations/{convId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.userId == request.auth.uid;

        match /messages/{msgId} {
          allow read, delete: if request.auth != null && request.auth.uid == userId;

          allow create, update: if request.auth != null
            && request.auth.uid == userId
            && request.resource.data.role in ['user', 'model', 'system'];
        }
      }

      // =======================================================================
      // KHỐI 5: TIẾN ĐỘ VÀ THÀNH TÍCH ACADEMY (/users/{userId}/academy/progress & /users/{userId}/academyDaily/{dateKey})
      // - Chỉ chủ tài khoản mới được đọc và ghi tiến độ học tập của mình.
      // - totalXP: số không âm (>= 0).
      // - currentStreak: số không âm (>= 0).
      // =======================================================================
      match /academy/{docId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.totalXP is number
          && request.resource.data.totalXP >= 0;
      }

      match /academyDaily/{dateKey} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.earnedXP is number
          && request.resource.data.earnedXP >= 0;
      }

      // =======================================================================
      // KHỐI 6: TIẾN ĐỘ BÀI HỌC LỘ TRÌNH 90 NGÀY (/users/{userId}/academyRoadmap/{lessonId})
      // - Tách biệt hoàn toàn khỏi tiến độ XP/Streak (/academy/progress).
      // - Chỉ chủ tài khoản mới được đọc và tạo tiến độ hoàn thành bài học của chính mình.
      // - Siết chặt schema: chỉ đúng 5 trường bắt buộc, số nguyên, khớp lessonId/dayNumber/stageId,
      //   completedAt đúng định dạng ISO 8601 (20–40 ký tự), không cho phép UPDATE hoặc DELETE.
      // =======================================================================
      match /academyRoadmap/{lessonId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly([
            'lessonId', 'dayNumber', 'stageId', 'completed', 'completedAt'
          ])
          && request.resource.data.keys().hasAll([
            'lessonId', 'dayNumber', 'stageId', 'completed', 'completedAt'
          ])
          && request.resource.data.dayNumber is int
          && request.resource.data.dayNumber >= 1
          && request.resource.data.dayNumber <= 90
          && request.resource.data.lessonId is string
          && request.resource.data.lessonId == lessonId
          && lessonId == 'day-' + string(request.resource.data.dayNumber)
          && request.resource.data.stageId is int
          && (
            (request.resource.data.stageId == 1 && request.resource.data.dayNumber >= 1 && request.resource.data.dayNumber <= 15) ||
            (request.resource.data.stageId == 2 && request.resource.data.dayNumber >= 16 && request.resource.data.dayNumber <= 30) ||
            (request.resource.data.stageId == 3 && request.resource.data.dayNumber >= 31 && request.resource.data.dayNumber <= 60) ||
            (request.resource.data.stageId == 4 && request.resource.data.dayNumber >= 61 && request.resource.data.dayNumber <= 90)
          )
          && request.resource.data.completed == true
          && request.resource.data.completedAt is string
          && request.resource.data.completedAt.size() >= 20
          && request.resource.data.completedAt.size() <= 40
          && request.resource.data.completedAt.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$');

        allow update, delete: if false;
      }
    }
  }
}
