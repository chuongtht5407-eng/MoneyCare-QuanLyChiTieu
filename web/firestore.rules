rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // NGUYÊN TẮC BẢO MẬT: MẶC ĐỊNH TỪ CHỐI TẤT CẢ (DEFAULT DENY)
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // =========================================================================
    // KHỐI 1: BẢNG HỒ SƠ NGƯỜI DÙNG (/users/{userId})
    // - Chỉ chủ tài khoản mới được quyền đọc và ghi dữ liệu của chính mình.
    // - Kiểm tra tính hợp lệ: displayName phải là chuỗi từ 1 đến 50 ký tự.
    // - uid (nếu có trong body) phải trùng khớp với request.auth.uid.
    // =========================================================================
    match /users/{userId} {
      allow read, delete: if request.auth != null && request.auth.uid == userId;

      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() > 0
        && request.resource.data.displayName.size() <= 50
        && (!('uid' in request.resource.data) || request.resource.data.uid == request.auth.uid)
        && (!('email' in request.resource.data) || request.resource.data.email is string);

      // =======================================================================
      // KHỐI 2: DANH SÁCH GIAO DỊCH THU / CHI (/users/{userId}/transactions/{txId})
      // - Chỉ chủ tài khoản mới được đọc, tạo, sửa, xóa giao dịch của mình.
      // - type: bắt buộc là 'income' hoặc 'expense'.
      // - amount: bắt buộc là số dương (> 0).
      // - date: bắt buộc là chuỗi ngày tháng (YYYY-MM-DD).
      // - note: nếu có phải là chuỗi không quá 500 ký tự.
      // =======================================================================
      match /transactions/{txId} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.type in ['income', 'expense']
          && request.resource.data.amount is number
          && request.resource.data.amount > 0
          && request.resource.data.date is string
          && (!('note' in request.resource.data) || (request.resource.data.note is string && request.resource.data.note.size() <= 500));
      }

      // =======================================================================
      // KHỐI 3: THIẾT LẬP NGÂN SÁCH THÁNG (/users/{userId}/budgets/{monthYear})
      // - Chỉ chủ tài khoản mới được đọc, lưu và xóa ngân sách tháng của mình.
      // - totalLimit: bắt buộc là số không âm (>= 0).
      // =======================================================================
      match /budgets/{monthYear} {
        allow read, delete: if request.auth != null && request.auth.uid == userId;

        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.totalLimit is number
          && request.resource.data.totalLimit >= 0;
      }
    }
  }
}
